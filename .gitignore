/toolchain/
/.godot/
/dev/shots/
__pycache__/

# Built models and the hall's baked lighting, restored by tools/build_models.ps1
/assets/models/*.glb
/assets/models/*.unwrap_cache
/assets/lightmaps/

# The grinner's baked textures, unpacked from grinner.glb when Godot imports it
/assets/models/*.png
/assets/models/*.png.import

# Poly Haven downloads, restored by tools/fetch_assets.ps1
/assets/textures/*/*.jpg
/assets/hdri/*.hdr

# The playtest launcher, built by tools/playtest/install.ps1
/tools/playtest/playtest.exe
/tools/playtest/playtest.ico

# Animation library formats the knight build does not read
/tools/downloads/**/*.fbx
/tools/downloads/**/*.blend

# ICT-FaceKit, restored by tools/fetch_assets.ps1, and the face model and pool of faces tools/faces builds from it
/tools/downloads/ict_facekit/
/tools/downloads/makehuman/
/tools/faces/model.npz
/tools/faces/pool/
