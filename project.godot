; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Clockwork Knight"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
run/max_fps=60

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/lightmap_bake/plugin.cfg")

[physics]

common/physics_ticks_per_second=120
3d/default_gravity=22.0

[rendering]

textures/default_filters/anisotropic_filtering_level=4
environment/ssao/quality=3
anti_aliasing/quality/msaa_3d=1
environment/subsurface_scattering/subsurface_scattering_quality=2
environment/volumetric_fog/volume_size=96
environment/volumetric_fog/volume_depth=96
lightmapping/bake_performance/region_size=128
anti_aliasing/quality/screen_space_aa=2
environment/screen_space_reflection/roughness_quality=2
